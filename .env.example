# Pastaa — environment variables
#
# Local development:
#   cp .env.example .env.local
#   Fill in the values (never commit `.env.local`).
#
# Next.js loads `.env.local` automatically.

# --- Required (Prisma database / encrypted pastes) ---
# PostgreSQL connection string. With Supabase, use the pooler (port 6543) and PgBouncer.
# For `npx prisma db push` / migrations, use a direct session (port 5432, no `pgbouncer=true`) if the pooler hangs.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true

# --- Recommended (link validation for emails from /send) ---
# Development: http://localhost:3000 — production: https://your-domain.tld
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (email sending with Resend, from /send) ---
# Create an API key at https://resend.com.
# In production use a sender from a verified Resend domain, without wrapping quotes.
RESEND_API_KEY=
RESEND_FROM=Pastaa <noreply@your-domain.tld>
EMAIL_VERIFICATION_SECRET=

# --- Required when email sending is enabled (Cloudflare Turnstile CAPTCHA) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_VERIFICATION_SECRET=your_random_secret

# --- Optional (realtime chat with Pusher) ---
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu
PUSHER_APP_ID=
PUSHER_SECRET=
