generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paste {
  id                       String    @id @default(uuid())
  shortId                  String    @unique
  encryptedContent         String
  iv                       String
  passwordIv               String?
  salt                     String?
  hasPassword              Boolean   @default(false)
  burnAfterReading         Boolean   @default(false)
  expiresAt                DateTime?
  createdAt                DateTime  @default(now())
  views                    Int       @default(0)
  encryptedFileContent     String?
  fileIv                   String?
  encryptedFileMetadata    String?
  fileMetadataIv           String?
  passwordFileIv           String?
  passwordFileMetadataIv   String?
  fileSize                 Int?
  encryptedFiles           String?
}

model PublicPage {
  id        String    @id @unique
  content   String    @default("")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ChatFile {
  id          String   @id @default(uuid())
  channelHash String
  storagePath String   @unique
  size        Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([channelHash])
}

