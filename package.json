{
  "name": "pastaa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply pastaa --local",
    "db:remote": "wrangler d1 migrations apply pastaa --remote",
    "deploy": "npm run typecheck && npm run build && node scripts/deploy-free.mjs"
  },
  "dependencies": {
