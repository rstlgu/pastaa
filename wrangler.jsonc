{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pastaa",
  "account_id": "5047cd4a2fb6e12bc13dc99bc62a7dc6",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pastaa",
      "database_id": "26c44bdf-d450-4743-89d2-ef455145ad35",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "APP_URL": "https://pastaa.io",
    "PUSHER_CLUSTER": "eu"
  }
}
